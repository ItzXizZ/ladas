# Copy to .env and fill in. Never commit .env.

# Writing agents: product brief, story cards, script, scene specs, describe-a-character, QC vision review.
# Without it the studio falls back to fill-in templates.
ANTHROPIC_API_KEY=
# Optional. Leave empty to auto-pick the newest Sonnet-class model your key can use.
ANTHROPIC_MODEL=

# Premium voices. Without it only the free local Kokoro voices are offered.
ELEVENLABS_API_KEY=

# Optional overrides
PORT=5173
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# BROWSER_CHANNEL=chrome

# Password gate for a hosted site. Required on Vercel (the site stays closed without it).
# Leave empty locally to skip the sign-in screen.
SITE_PASSWORD=
# Optional extra salt for the session cookie.
# SESSION_SECRET=
# Container hosts: listen on all interfaces and keep data on a persistent volume.
# HOST=0.0.0.0
# DATA_DIR=/data

# Supabase persistence (optional). With both set, records and files are mirrored to your project and restored on start.
# Use the SECRET key from Project Settings -> API Keys. Never expose it to the browser.
# SUPABASE_URL=https://hvhagxhcaivmgvgirygo.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Container only: path to the Chromium and ffmpeg inside the image (the Dockerfile sets these).
# CHROME_PATH=/usr/bin/chromium
